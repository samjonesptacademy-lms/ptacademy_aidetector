# PT Academy AI Content Checker Configuration
# Copy this file to .env and fill in your actual values

# Zero GPT API Key - Get from https://api.zerogpt.com
ZEROGPT_API_KEY=your-api-key-here

# Dropbox Refresh Token - For automatic PDF report uploads
# Generate using: python get_dropbox_refresh_token.py
# This token never expires and is used to automatically refresh access tokens
DROPBOX_REFRESH_TOKEN=your-refresh-token-here

# Flask Configuration (optional)
FLASK_ENV=development
FLASK_DEBUG=false
PORT=5001

# PT Academy AI Content Checker Configuration
# Copy this file to .env and fill in your actual values

# Zero GPT API Key - Get from https://api.zerogpt.com
ZEROGPT_API_KEY=your-api-key-here

# Dropbox Access Token - For automatic PDF report uploads
# Create a Dropbox app at https://www.dropbox.com/developers/apps and generate a token
DROPBOX_ACCESS_TOKEN=your-dropbox-token-here

# Flask Configuration (optional)
FLASK_ENV=development
FLASK_DEBUG=false
PORT=5001
